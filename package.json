{
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "lint": "eslint .",
    "prepare": "nuxt prepare",
    "generate": "nuxt generate",
    "check:server-runtime-deps": "node scripts/check-server-runtime-deps.mjs",
    "release": "bumpp",
    "start": "nuxt start",
    "start:generate": "npx serve .output/public",
    "typecheck": "nuxt typecheck",
    "docs:dev": "pnpm -C docs docs:dev",
    "docs:build": "pnpm -C docs docs:build",
    "docs:preview": "pnpm -C docs docs:preview",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "sync": "LANG=en_US.UTF-8 cap sync",
    "open:ios": "cap open ios",
    "dev:ios": "LANG=en_US.UTF-8 cap run ios -l --port=8080",
    "run:ios": "LANG=en_US.UTF-8 cap run ios",
    "run:ios:build": "nuxt build && LANG=en_US.UTF-8 cap sync && LANG=en_US.UTF-8 cap run ios",
    "sync:version": "bash scripts/sync-ios-version.sh",
    "build:android:release": "bash scripts/android-release.sh",
    "build:ios": "bash scripts/ios-archive.sh",
    "build:ios:adhoc": "pnpm sync:version && LANG=en_US.UTF-8 cap build ios --xcode-export-method release-testing --xcode-team-id QT792GAY4C",
    "publish:ios:testflight": "node scripts/ios-testflight-publish.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@cloudbase/node-sdk": "^3.18.3",
    "@vueuse/core": "^14.3.0",
    "@yunlefun/types": "^0.2.1",
    "aegis-web-sdk": "^1.41.14",
    "cordova-plugin-wechat": "^3.1.0",
    "fuse.js": "^7.5.0",
    "h3": "^1.15.11",
    "ionicons": "^8.0.13",
    "jsqr": "^1.4.0",
    "konsta": "^5.2.0",
    "markstream-vue": "^1.0.6",
    "ofetch": "^1.5.1",
    "tencentcloud-sdk-nodejs-tms": "^4.1.267",
    "vconsole": "^3.15.1",
    "vue": "3.5.40",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@capacitor/cli": "8.4.2",
    "@cloudbase/js-sdk": "^3.6.2",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.90",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/ionic": "1.0.2",
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/qrcode": "^1.5.6",
    "@unocss/eslint-config": "^66.7.5",
    "@unocss/nuxt": "^66.7.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/components": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "@yunlefun/toolkit": "^0.1.2",
    "@yunlefun/vue": "^0.1.1",
    "consola": "^3.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "magicast": "0.3.5",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
