{
  "name": "@yunlefun/apps",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "build": "pnpm --dir apps/mobile run build",
    "build:edgeone": "pnpm --dir apps/mobile run build:edgeone",
    "check:edgeone-output": "pnpm --dir apps/mobile run check:edgeone-output",
    "dev": "pnpm --dir apps/mobile run dev",
    "lint": "eslint .",
    "generate": "pnpm --dir apps/mobile run generate",
    "check:server-runtime-deps": "pnpm --dir apps/mobile run check:server-runtime-deps",
    "release": "pnpm --dir apps/mobile run release",
    "start": "pnpm --dir apps/mobile run start",
    "start:generate": "pnpm --dir apps/mobile run start:generate",
    "typecheck": "pnpm --dir apps/mobile run typecheck",
    "test": "pnpm --dir apps/mobile run test",
    "test:unit": "pnpm --dir apps/mobile run test:unit",
    "test:nuxt": "pnpm --dir apps/mobile run test:nuxt",
    "test:watch": "pnpm --dir apps/mobile run test:watch",
    "test:coverage": "pnpm --dir apps/mobile run test:coverage",
    "test:e2e": "pnpm --dir apps/mobile run test:e2e",
    "test:e2e:ui": "pnpm --dir apps/mobile run test:e2e:ui",
    "test:e2e:debug": "pnpm --dir apps/mobile run test:e2e:debug",
    "sync": "pnpm --dir apps/mobile run sync",
    "build:android:release": "pnpm --dir apps/mobile run build:android:release",
    "publish:ios:testflight": "pnpm --dir apps/mobile run publish:ios:testflight",
    "docs:dev": "pnpm --dir docs run docs:dev",
    "docs:build": "pnpm --dir docs run docs:build",
    "docs:preview": "pnpm --dir docs run docs:preview",
    "dev:mobile": "pnpm --dir apps/mobile run dev",
    "build:mobile": "pnpm --dir apps/mobile run build",
    "dev:desktop": "pnpm --dir apps/desktop run dev",
    "build:desktop": "pnpm --dir apps/desktop run build",
    "make:desktop": "pnpm --dir apps/desktop run make",
    "package:desktop": "pnpm --dir apps/desktop run package",
    "verify:desktop": "pnpm --dir apps/desktop run verify:package",
    "verify:desktop-artifacts": "pnpm --dir apps/desktop run verify:artifacts",
    "verify:desktop-launch": "pnpm --dir apps/desktop run verify:launch",
    "check:desktop-release": "pnpm --dir apps/desktop run check:release",
    "icons:desktop": "pnpm --dir apps/desktop run icons",
    "icons:sync": "node apps/desktop/scripts/sync-catalog-icons.mjs",
    "typecheck:desktop": "pnpm --dir apps/desktop run typecheck",
    "test:desktop": "pnpm --dir apps/desktop run test",
    "test:desktop:e2e": "pnpm --dir apps/desktop run test:e2e",
    "dev:macos": "./script/build_and_run.sh",
    "build:macos": "./script/build_and_run.sh --build",
    "test:macos": "./script/build_and_run.sh --test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@cloudbase/node-sdk": "^3.18.7",
    "@unocss/eslint-config": "^66.12.0",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1"
  }
}
