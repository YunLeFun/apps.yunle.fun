    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "dev:ios": "cap run ios -l --port=8080",
    "run:ios": "cap run ios",
    "run:ios:build": "nuxt build && cap sync && cap run ios",
    "build:ios": "cap build ios --xcode-export-method release-testing --xcode-team-id QT792GAY4C"
